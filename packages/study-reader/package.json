{
  "name": "dsh-study-reader",
  "description": "Document library, bounded preview, and evidence tools for DeepSeek Harness",
  "version": "0.5.8",
  "private": true,
  "type": "module",
  "main": "lib/types/index.js",
  "types": "lib/types/index.d.ts",
  "bin": {
    "dsh-study-reader-preset": "./install-reading-preset.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/types/index.js"
    },
    "./extraction": {
      "types": "./lib/types/extraction/index.d.ts",
      "default": "./lib/types/extraction/index.js"
    },
    "./mineru": {
      "types": "./lib/types/mineru/index.d.ts",
      "default": "./lib/types/mineru/index.js"
    },
    "./memory": {
      "types": "./lib/types/memory/index.d.ts",
      "default": "./lib/types/memory/index.js"
    },
    "./memory-durable": {
      "types": "./lib/types/memory/durable.d.ts",
      "default": "./lib/types/memory/durable.js"
    },
    "./agent": {
      "types": "./lib/types/agent/index.d.ts",
      "default": "./lib/types/agent/index.js"
    },
    "./study": {
      "types": "./lib/types/study/index.d.ts",
      "default": "./lib/types/study/index.js"
    },
    "./study-blob-lifecycle": {
      "types": "./lib/types/study/blob-lifecycle.d.ts",
      "default": "./lib/types/study/blob-lifecycle.js"
    },
    "./tools": {
      "types": "./lib/types/tools/index.d.ts",
      "default": "./lib/types/tools/index.js"
    },
    "./protocol": {
      "types": "./lib/types/protocol/events.d.ts",
      "default": "./lib/types/protocol/events.js"
    },
    "./domain": {
      "types": "./lib/types/domain/reducer.d.ts",
      "default": "./lib/types/domain/reducer.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/types/**/*.d.ts",
    "lib/types/**/*.js",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/typert.remote-client.d.ts.map",
    "lib/client.js",
    "lib/client.js.map",
    "pdfjs-wasm/*.wasm",
    "pdfjs-worker/pdf.worker.mjs",
    "cordis.patch.yml",
    "skills/**",
    "presets/**",
    "install-reading-preset.mjs",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-tool"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0",
    "@deepseek-ai/dsh-api-remotes": "^0.1.0",
    "@deepseek-ai/dsh-api-session-controller": "^0.1.0",
    "@deepseek-ai/dsh-brand": "^0.1.0",
    "@deepseek-ai/dsh-client-locale": "^0.1.0",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0",
    "@deepseek-ai/dsh-client-ui-tool": "^0.1.0",
    "@deepseek-ai/dsh-commands": "^0.1.0",
    "@deepseek-ai/dsh-credentials": "^0.1.0",
    "@deepseek-ai/dsh-llm": "^0.1.0",
    "@deepseek-ai/dsh-session": "^0.1.0",
    "@deepseek-ai/dsh-skill": "^0.1.0",
    "@deepseek-ai/dsh-storage-domain": "^0.1.0",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0",
    "@deepseek-ai/dsh-tools": "^0.1.0",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-util-values": "^0.1.0",
    "@deepseek-ai/schemastery": "^2.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "@deepseek-ai/dsh-typert-protocol": "link:../../../packages/typert/protocol",
    "epubjs": "0.3.93",
    "minisearch": "^7.1.2",
    "parse5": "7.3.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.2.108",
    "yazl": "^3.3.1",
    "yauzl": "^3.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../../../vendor/cordis",
    "@deepseek-ai/cordis-plugin-timer": "link:../../../vendor/timer",
    "@deepseek-ai/dsh-agent": "link:../../../packages/core/agent",
    "@deepseek-ai/dsh-api-remotes": "link:../../../packages/api/remotes",
    "@deepseek-ai/dsh-api-session-controller": "link:../../../packages/api/session-controller",
    "@deepseek-ai/dsh-brand": "link:../../../packages/util/brand",
    "@deepseek-ai/dsh-client-locale": "link:../../../packages/client/locale",
    "@deepseek-ai/dsh-client-ui-primitives": "link:../../../packages/client/ui-primitives",
    "@deepseek-ai/dsh-client-ui-tool": "link:../../../packages/client/ui-tool",
    "@deepseek-ai/dsh-commands": "link:../../../packages/interaction/commands",
    "@deepseek-ai/dsh-credentials": "link:../../../packages/credentials/credentials",
    "@deepseek-ai/dsh-host-webserver": "link:../../../packages/host/webserver",
    "@deepseek-ai/dsh-llm": "link:../../../packages/llm/llm",
    "@deepseek-ai/dsh-scope": "link:../../../packages/core/scope",
    "@deepseek-ai/dsh-session": "link:../../../packages/core/session",
    "@deepseek-ai/dsh-skill": "link:../../../packages/skill/skill",
    "@deepseek-ai/dsh-skill-filesystem": "link:../../../packages/skill/skill-filesystem",
    "@deepseek-ai/dsh-storage": "link:../../../packages/storage/storage",
    "@deepseek-ai/dsh-storage-domain": "link:../../../packages/storage/storage-domain",
    "@deepseek-ai/dsh-storage-json": "link:../../../packages/storage/storage-json",
    "@deepseek-ai/dsh-system-prompt": "link:../../../packages/core/system-prompt",
    "@deepseek-ai/dsh-tools": "link:../../../packages/core/tools",
    "@deepseek-ai/dsh-typert-generator": "link:../../../packages/typert/generator",
    "@deepseek-ai/dsh-util-values": "link:../../../packages/util/values",
    "@deepseek-ai/schemastery": "link:../../../vendor/schemastery",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.7",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^2.4.5",
    "js-yaml": "^4.1.0",
    "jsdom": "^25.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
